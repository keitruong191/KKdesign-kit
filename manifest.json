{
  "name": "KKdesign-kit",
  "identifier": "kkdesign-kit",
  "version": "0.5.0a1",
  "status": "workflow-preview",
  "targets": [
    "codex",
    "claude-code"
  ],
  "implemented": [
    "lesson-index",
    "product-profile-contract",
    "task-contract",
    "task-evidence-contract",
    "offline-validation",
    "skill-installation",
    "command-menu",
    "package",
    "installation-inspection",
    "update",
    "rollback",
    "uninstall",
    "init",
    "refresh",
    "source-adapters",
    "source-migration",
    "project-recovery",
    "design",
    "review",
    "prototype",
    "learn",
    "extracted-package-verification",
    "managed-helper-runtime",
    "agent-setup-consent",
    "macos-python-bootstrap"
  ],
  "planned": [
    "optional-hooks"
  ],
  "externalRuntimeDependencies": [
    "Python >=3.9",
    "jsonschema >=4.18,<5"
  ],
  "requiresInstalledImpeccable": false,
  "requiresInstalledHoangsa": false,
  "supportGuide": "docs/compatibility.md",
  "harnessAdapters": {
    "codex": {
      "user": "~/.agents/skills/kkdesign-kit",
      "project": ".agents/skills/kkdesign-kit",
      "invocation": "$kkdesign-kit"
    },
    "claude-code": {
      "user": "~/.claude/skills/kkdesign-kit",
      "project": ".claude/skills/kkdesign-kit",
      "invocation": "/kkdesign-kit"
    }
  },
  "hooks": "not-installed; opt-in integration deferred",
  "compatibility": {
    "toolAccess": "Codex CLI or Claude Code must be installed and authenticated separately; live design operations need a separately authorized design-tool connection",
    "optionalIntegrations": "Hoangsa, Impeccable, MCP servers and hooks are not installed or required",
    "verificationBoundary": "Offline validation checks contracts and package integrity; live behavior, rendered results and owner approval require separate verification"
  },
  "requiredResources": [
    "SKILL.md",
    "manifest.json",
    "LICENSE",
    "requirements.txt",
    "agents/openai.yaml",
