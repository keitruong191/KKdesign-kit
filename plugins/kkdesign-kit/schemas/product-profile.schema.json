{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "product",
    "platform",
    "status",
    "scope",
    "sources",
    "decisions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "product-profile"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "product": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "enum": [
        "web",
        "macos",
        "ios",
        "android",
        "windows",
        "adaptive"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "superseded"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "location",
          "revision",
          "observedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "observedAt": {
            "type": "string",
            "format": "date"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "topic",
          "value",
          "status",
          "scope",
          "sourceIds",
          "recheckWhen"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "value": {},
          "status": {
            "enum": [
              "confirmed",
              "observed",
              "inferred",
              "open",
              "superseded"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "sourceIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "recheckWhen": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
