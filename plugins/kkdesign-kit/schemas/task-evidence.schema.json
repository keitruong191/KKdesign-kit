{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "record"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "task-evidence"
    },
    "record": {
      "type": "object",
      "required": [
        "taskId",
        "evidenceType",
        "historicalStatus",
        "description",
        "payloadSha256",
        "references"
      ],
      "properties": {
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "evidenceType": {
          "enum": [
            "snapshot",
            "audit",
            "style-review",
            "correction"
          ]
        },
        "historicalStatus": {
          "enum": [
            "current",
            "superseded",
            "historical"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "payloadSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  }
}
