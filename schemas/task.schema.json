{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "projectRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "webArtifact": {
      "type": "object",
      "required": [
        "entry",
        "instructions",
        "launch"
      ],
      "properties": {
        "entry": {
          "$ref": "#/$defs/projectRelativePath"
        },
        "instructions": {
          "$ref": "#/$defs/projectRelativePath"
        },
        "launch": {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "file",
                "command"
              ]
            },
            "cwd": {
              "$ref": "#/$defs/projectRelativePath"
            },
            "argv": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "command"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "then": {
                "required": [
                  "cwd",
                  "argv"
                ]
              }
            }
          ]
        }
      }
    }
  },
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "status",
    "objective",
    "platform",
    "productProfileId",
    "target",
    "designPlan",
    "lessonReview",
    "handoff"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "kind": {
      "enum": [
        "task-template",
        "design-task"
      ]
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": [
        "string",
        "null"
      ]
    },
    "platform": {
      "type": [
        "string",
        "null"
      ]
    },
    "delivery": {
      "type": "string"
    },
    "productProfileId": {
      "type": [
        "string",
        "null"
      ]
    },
    "target": {
      "type": "object"
    },
    "designPlan": {
      "type": "object"
    },
    "lessonReview": {
      "type": "object",
      "required": [
        "status",
        "sourceHash",
        "entries"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "reviewed",
            "retrospective",
            "not-applicable"
          ]
        },
        "sourceHash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "lessonId",
              "decision",
              "reason",
              "verification",
              "evidence"
            ],
            "properties": {
              "lessonId": {
                "type": "string",
                "pattern": "^DL-[0-9]{3}$"
              },
              "decision": {
                "enum": [
                  "apply",
                  "not-applicable"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "verification": {
                "enum": [
                  "pending",
                  "pass",
                  "evidence-mapped",
                  "not-applicable"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "handoff": {
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/webArtifact"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "design-task"
          }
        }
      },
      "then": {
        "required": [
          "taskId"
        ],
        "properties": {
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "productProfileId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "delivery": {
            "enum": [
              "html_prototype",
              "react_prototype"
            ]
          }
        },
        "required": [
          "delivery"
        ]
      },
      "then": {
        "properties": {
          "target": {
            "required": [
              "destination"
            ],
            "properties": {
              "destination": {
                "allOf": [
                  {
                    "$ref": "#/$defs/projectRelativePath"
                  },
                  {
                    "pattern": "^design/prototypes/[^/]+$"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "delivery": {
            "enum": [
              "html_prototype",
              "react_prototype"
            ]
          },
          "status": {
            "enum": [
              "design_delivered",
              "design_verified_review_pending"
            ]
          }
        },
        "required": [
          "delivery",
          "status"
        ]
      },
      "then": {
        "properties": {
          "handoff": {
            "required": [
              "artifacts"
            ],
            "properties": {
              "artifacts": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "delivery": {
            "const": "react_prototype"
          }
        },
        "required": [
          "delivery"
        ]
      },
      "then": {
        "properties": {
          "handoff": {
            "properties": {
              "artifacts": {
                "items": {
                  "properties": {
                    "launch": {
                      "properties": {
                        "mode": {
                          "const": "command"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
